 "events": [
  {
   "t": "14:50",
   "title": "The Overmountain men arrive",
   "text": "Nine hundred picked horsemen, in the saddle since eight the night before through steady rain, halt a quarter mile from the ridge. Ferguson's camp on the summit is in full view. They tie their horses and form two lines of two columns each.",
   "at": [
    -450,
    60
   ],
   "view": 1400
  },
  {
   "t": "15:00",
   "title": "Here they are, my brave boys",
   "text": "Loyalist pickets fire on Shelby's column before it is in place. Campbell's Virginians and Shelby's Sullivan men open the attack on the narrow south-west end while the two wings run to circle the mountain.",
   "at": [
    -230,
    -180
   ],
   "view": 700
  },
  {
   "t": "15:06",
   "title": "The bayonet",
   "text": "DePeyster's Provincials charge down the south-east slope with fixed bayonets. The riflemen have none. They give way to the foot of the hill, re-form among the trees, and climb again.",
   "at": [
    -170,
    -230
   ],
   "view": 550
  },
  {
   "t": "15:16",
   "title": "Shelby's turn",
   "text": "A second charge comes down the north-west face at Shelby's men. They fall back and climb again as soon as the bayonets turn around.",
   "at": [
    -240,
    -100
   ],
   "view": 550
  },
  {
   "t": "15:22",
   "title": "The noose closes",
   "text": "Cleveland's men, delayed by a swamp, and Winston's, who lost the columns and rode hard to catch up, reach the north-east end. Chronicle falls at the head of the South Fork men. Fire is general all round the mountain.",
   "at": [
    80,
    70
   ],
   "view": 900
  },
  {
   "t": "15:28",
   "title": "The third charge",
   "text": "The last charge drives the Virginians down the ridge in something close to a rout. Campbell rallies them. Attacks on the north and east slopes pull the Provincials back to the crest.",
   "at": [
    -170,
    -230
   ],
   "view": 550
  },
  {
   "t": "15:40",
   "title": "Downhill fire",
   "text": "From the crest the Loyalists overshoot. Musket balls fly over the heads of men climbing from tree to tree, while on the bare summit the close column of Loyalists is a fair mark for rifles. Mills' North Carolinians, out of ammunition, give way first.",
   "at": [
    -60,
    -70
   ],
   "view": 600
  },
  {
   "t": "15:46",
   "title": "The summit taken",
   "text": "Campbell and Shelby gain the south-west summit and hold it. The right wing comes over the crest and forces the Loyalists north-east along the ridge, where Cleveland's men stop them.",
   "at": [
    -120,
    -120
   ],
   "view": 600
  },
  {
   "t": "15:51",
   "title": "Ferguson falls",
   "text": "Ferguson, in a checked hunting shirt on a white horse, tries to cut through with two Loyalist colonels. He is hit by six or more balls and dragged by a stirrup. He dies within minutes.",
   "at": [
    157,
    84
   ],
   "view": 450
  },
  {
   "t": "15:56",
   "title": "Sixty yards by forty",
   "text": "The Loyalists are crowded into a pocket on the north-east end among their wagons. Ferguson's silver whistle is silent. DePeyster raises his white handkerchief.",
   "at": [
    110,
    80
   ],
   "view": 450
  },
  {
   "t": "16:00",
   "title": "Buford's play",
   "text": "The firing does not stop. Some men have not seen the flag; others remember Tarleton at the Waxhaws. Williams falls mortally wounded. Campbell shouts that it is murder to kill them now. A second flag ends it.",
   "at": [
    110,
    80
   ],
   "view": 450
  },
  {
   "t": "16:08",
   "title": "An hour and five minutes",
   "text": "Ferguson's force is destroyed: 157 killed, 163 wounded, nearly 700 prisoners, and no one escaped. The Patriots lose 28 killed and 62 wounded. Cornwallis's march into North Carolina stops here.",
   "at": [
    0,
    0
   ],
   "view": 1100
  }
 ],
 "outcome": {
  "result": "Patriot victory",
  "losses": [
   [
    "patriot",

 "events": [
  {
   "t": "12:30",
   "title": "Two armies on the Salisbury road",
   "text": "At dawn Lee's Legion and Campbell's riflemen met Tarleton at New Garden Meeting House, four miles to the south-west, and fell back fighting. Greene's 4,400 men wait in three lines astride the road. Cornwallis's 1,900 regulars come on without breakfast.",
   "at": [
    -500,
    -150
   ],
   "view": 1600
  },
  {
   "t": "13:20",
   "title": "The head of the column",
   "text": "The British come down the hill, across Little Horsepen Creek and up toward the Hoskins farm. Singleton's two six-pounders open on the road. Macleod's guns answer, and for twenty minutes they duel while Cornwallis deploys: Leslie on the right, Webster on the left, the Guards in reserve.",
   "at": [
    -760,
    -210
   ],
   "view": 1000
  },
  {
   "t": "13:52",
   "title": "Across the fields",
   "text": "The 23rd and the 71st climb the fence into four hundred yards of wet ploughed ground. Behind the far fence the North Carolina militia have been asked for two volleys and no more.",
   "at": [
    -430,
    -120
   ],
   "view": 900
  },
  {
   "t": "14:02",
   "title": "The first line",
   "text": "At forty yards the militia fire. The British volley back and go in with the bayonet. The North Carolinians run, most of them straight through the Virginians toward the courthouse and on home. On the flanks the riflemen stand, and the British line begins to split in three.",
   "at": [
    -230,
    -80
   ],
   "view": 800
  },
  {
   "t": "14:13",
   "title": "The second line",
   "text": "Three hundred yards on, in woods thick with underbrush, the Virginia militia fight from tree to tree. The 23rd and the Guards grenadiers press Lawson; the 71st and the 2nd Guards press Stevens. Cornwallis's horse is shot under him.",
   "at": [
    120,
    60
   ],
   "view": 800
  },
  {
   "t": "14:27",
   "title": "The separate fight",
   "text": "On the American left, Lee and Campbell draw the 1st Guards and the Hessians half a mile south into the woods, away from the main battle. Stuart's Virginians strike the Guards in the flank before von Bose comes up to save them.",
   "at": [
    250,
    -650
   ],
   "view": 1200
  },
  {
   "t": "14:41",
   "title": "Webster goes in alone",
   "text": "The 33rd, with the j\u00e4gers and the Guards light company, crosses the vale and climbs at the American right before the rest of the army is up. The 1st Maryland and Hawes's Virginians shatter it with volleys. Webster, shot through the knee, pulls back across the ravine.",
   "at": [
    720,
    460
   ],
   "view": 700
  },
  {
   "t": "14:55",
   "title": "The Guards and the 2nd Maryland",
   "text": "Stuart's 2nd Guards reach the cleared ground by the courthouse and find the 2nd Maryland, raw recruits, trying to wheel to meet them. One volley and a charge break the Marylanders and take Singleton's guns.",
   "at": [
    800,
    215
   ],
   "view": 600
  },
  {
   "t": "15:04",
   "title": "Howard wheels the 1st Maryland",
   "text": "Gunby and Howard swing the 1st Maryland onto the Guards' flank and fire so close that the muzzle flashes meet. Washington's dragoons come in from the rear. Stuart is killed, the guns are retaken, and the Guards are driven back into the field under grape from their own three-pounders.",
   "at": [
    810,
    250
   ],
   "view": 500
  },
  {
   "t": "15:21",
   "title": "Greene decides",
   "text": "The 71st and the 23rd come up into the clearing and Webster drives at Hawes again. With his left broken and the British gaining on his right, Greene orders a retreat. Green's Virginians cover it. The four guns, their horses dead, are left behind.",
   "at": [
    820,
    320
   ],
   "view": 900
  },
  {
   "t": "15:40",
   "title": "Another such victory",
   "text": "The Americans go north by the Reedy Fork road and are followed only three miles. Cornwallis holds the field with 532 men killed or wounded, a quarter of his army, the Guards above half. It rains all night on the wounded. Greene lost 79 killed and 185 wounded; most of the militia went home.",
   "at": [
    850,
    600
   ],
   "view": 1400
  }
 ],

 "events": [
  {
   "t": "06:40",
   "title": "Before dawn",
   "text": "Morgan's three lines have stood formed since first light on the slope above the Green River Road, the Broad River six miles at their backs. Tarleton's column, on the road since three in the morning, is closing from the south-east.",
   "at": [
    300,
    -150
   ],
   "view": 1300
  },
  {
   "t": "06:52",
   "title": "First contact",
   "text": "Tarleton sends Ogilvie's fifty Legion dragoons up the road at the skirmishers. McDowell's and Cunningham's riflemen empty saddles and the horsemen recoil.",
   "at": [
    330,
    -190
   ],
   "view": 650
  },
  {
   "t": "07:03",
   "title": "Tarleton deploys",
   "text": "Light infantry on the right, Legion infantry in the centre, the 7th Foot on the left, a three-pounder in each gap and fifty dragoons on each flank. The 71st and two hundred Legion cavalry wait in reserve. The guns open fire.",
   "at": [
    470,
    -230
   ],
   "view": 800
  },
  {
   "t": "07:15",
   "title": "The advance",
   "text": "The British line comes up the slope at a trot. Pickens' militia have orders to fire twice at close range and then file off around the left.",
   "at": [
    230,
    -120
   ],
   "view": 650
  },
  {
   "t": "07:21",
   "title": "Two volleys",
   "text": "At fifty yards the militia line fires. Two-thirds of the officers in the leading companies go down. The militia withdraw as ordered, most by the left, some by the right.",
   "at": [
    160,
    -70
   ],
   "view": 550
  },
  {
   "t": "07:25",
   "title": "Dragoons on the left",
   "text": "The 17th Light Dragoons ride round the American left after the militia and begin cutting them down. Washington's dragoons and the sabre-armed militia horse burst out of the trees and drive them off.",
   "at": [
    200,
    110
   ],
   "view": 600
  },
  {
   "t": "07:30",
   "title": "The main line",
   "text": "Howard's Continentals and the Virginians meet the British line on the forward crest. Both sides stand and fire; British balls are later found thirty feet up in the trees.",
   "at": [
    80,
    -20
   ],
   "view": 500
  },
  {
   "t": "07:40",
   "title": "The Highlanders",
   "text": "Tarleton sends the 71st past the marsh to turn the American right. Howard orders Wallace's company to wheel back and refuse the flank. The order is taken as a retreat, and within a minute the whole line is marching to the rear.",
